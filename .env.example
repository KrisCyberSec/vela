# Vela environment variables.
# Copy to `.env.local` (gitignored) and fill in real values.
# Setup steps for each: docs/operations/analytics-and-billing.md
#
# All three are optional — modules no-op without them, so local dev
# works out of the box and the prod build won't crash if a key is missing.

# RevenueCat — iOS app's "Apple" public API key (starts with `appl_`).
# Native-only: ignored on web. Without this, the paywall unlocks premium
# locally for testing but no real purchase happens.
REACT_APP_REVENUECAT_IOS_API_KEY=

# PostHog — project API key (starts with `phc_`).
REACT_APP_POSTHOG_KEY=
# Optional override; defaults to https://us.i.posthog.com if unset.
REACT_APP_POSTHOG_HOST=
# Optional: set to true only when intentionally testing analytics from npm start.
REACT_APP_ENABLE_DEV_ANALYTICS=false

# Sentry — project DSN (looks like https://<key>@<orgid>.ingest.sentry.io/<projectid>).
REACT_APP_SENTRY_DSN=
